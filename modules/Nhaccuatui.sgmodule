#!name= Unlock Nhaccuatui
#!desc= Nhaccuatui

[MITM]
hostname = %APPEND% graph.nhaccuatui.com

[Script]
Nhaccuatui = type=http-response,pattern=^https:\/\/graph\.nhaccuatui\.com\/.*\/users\/info,requires-body=1,max-size=0,script-update-interval=-1,script-path=https://ifade.vercel.app/scripts/nhaccuatui.js 
