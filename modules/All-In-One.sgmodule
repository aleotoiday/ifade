#!name= 𝙰𝚕𝚕 𝙸𝚗 𝙾𝚗𝚎

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[URL Rewrite]
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) _ reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext _ reject-200

[Header Rewrite]
^https:\/\/api\.(picsart|meiease)\.c(n|om)\/users\/show\/me\.json header-del if-none-match

http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ header-del if-none-match

[MITM]
hostname= %APPEND% api.revenuecat.com, us-central1-alight-creative.cloudfunctions.net, photos.adobe.io, api-mobile.soundcloud.com, spclient.wg.spotify.com, *spclient.spotify.com, redirector*.googlevideo.com,*.googlevideo.com,www.youtube.com,s.youtube.com,youtubei.googleapis.com, nicegram.cloud, api.picsart.com, ap*.intsig.net, mobile-api.adguard.org, restore-access.indream.app, isi.csan.goodnotes.com

[Script]

# > AdGuard
hostname= mobile-api.adguard.org
AdGuard=type=http-response,pattern=^https?:\/\/mobile-api\.adguard\.org\/api\/.+\/ios_validate_receipt,requires-body=1,script-path=https://ifade.vercel.app/scripts/adguard.js

————————————————————————————————————————————————————

# > Alight Motion
hostname= us-central1-alight-creative.cloudfunctions.net
AlightMotion=type=http-response,pattern=^https:\/\/us-central1-alight-creative\.cloudfunctions\.net\/getAccountStatusAndLicenses$,requires-body=true,timeout=5,script-path=https://ifade.vercel.app/scripts/alightmotion.js

————————————————————————————————————————————————————

# > Lightroom
hostname= photos.adobe.io
LightRoom=type=http-response,pattern=^https:\/\/photos\.adobe\.io\/v2\/accounts*,requires-body=1, max-size=0,script-path=https://ifade.vercel.app/scripts/lightroom.js,script-update-interval=-1

————————————————————————————————————————————————————

# > Locket
hostname= api.revenuecat.com
RevenueCat=type=http-response,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$),requires-body=true,max-size=-1, timeout=60,script-path=https://ifade.vercel.app/scripts/locket.js

————————————————————————————————————————————————————

# > SoundCloud
hostname= api-mobile.soundcloud.com
SoundCloudGo= type=http-response,pattern=https://api-mobile.soundcloud.com/configuration/ios,requires-body=1,script-path=https://ifade.vercel.app/scripts/soundcloud.js

————————————————————————————————————————————————————

# > Spotify
hostname= spclient.wg.spotify.com, *spclient.spotify.com
spotify-json = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/,requires-body=0,script-path=https://ifade.vercel.app/scripts/spotify-json.js

spotify-proto = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://ifade.vercel.app/scripts/spotify-proto.js,script-update-interval=0

————————————————————————————————————————————————————

# > YouTube
hostname= redirector*.googlevideo.com,*.googlevideo.com,www.youtube.com,s.youtube.com,youtubei.googleapis.com
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch),requires-body=1,max-size=-1,binary-body-mode=1,engine=default,script-path=https://ifade.vercel.app/scripts/YouTube.js,argument="{}"

————————————————————————————————————————————————————

# > NiceGram
hostname= nicegram.cloud, restore-access.indream.app
Nicegram = type=http-response,pattern=^https?:\/\/(nicegram\.cloud\/api\/v\d\/user\/info|restore-access\.indream\.app\/restoreAccess),requires-body=1,max-size=0,script-update-interval=0,script-path=https://ifade.vercel.app/scripts/Nicegram.js

————————————————————————————————————————————————————

# > CamScanner
hostname= ap*.intsig.net
Camscanner = type=http-response,pattern= https:\/\/(api|api-cs.*)\.intsig\.net\/purchase\/cs\/query_property\?,requires-body=1,script-path=https://ifade.vercel.app/scripts/camscanner.js

————————————————————————————————————————————————————

# > Picsart
hostname= api.picsart.com
Picsart=type=http-request,pattern=https:\/\/api\.picsart\.com\/gw-v2\/shop\/subscription\/apple\/purchases$,requires-body=true,timeout=5,script-path=https://ifade.vercel.app/scripts/picsart.js

————————————————————————————————————————————————————

# > Goodnotes
hostname= isi.csan.goodnotes.com
Goodnotes = type=http-response,pattern=^https:\/\/isi\.csan\.goodnotes\.com\/.+\/(receipts$|subscribers\/[^/]+$),requires-body=true,max-size=-1,timeout=60,script-path=https://ifade.vercel.app/scripts/Goodnotes.js
