#!name= All In One
#!desc= Unlock Premium

[URL Rewrite]
^https:\/\/api\.vtvgiaitri\.vn\/api\/v\d\/advertising - reject

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[Script]
# > Sub-Store
#hostname = sub.store
Sub-Store Core=type=http-request,pattern=^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info))),script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-1.min.js,requires-body=true,timeout=120
Sub-Store Simple=type=http-request,pattern=^https?:\/\/sub\.store,script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-0.min.js,requires-body=true

Sub-Store Sync=type=cron,cronexp=0 0 * * *,wake-system=1,timeout=120,script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/cron-sync-artifacts.min.js

# > Youtube
#hostname = *.googlevideo.com, youtubei.googleapis.com
YouTube = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://ifade.vercel.app/scripts/YouTube.js,argument="{"lyricLang":"{{{dịch lời bài hát}}","captionLang":"{{{dịch phụ đề}}}","blockUpload":{{{ẩn tải lên}}},"blockImmersive":{{{ẩn nút chọn đoạn}}},"blockShorts":{{{ẩn nút short}}},"debug":{{{bật chế độ gỡ lỗi}}}}"

# > Camscanner
#hostname = ap*.intsig.net
Camscanner = requires-body=1,script-path=https://ifade.vercel.app/scripts/camscanner.js,type=http-response,pattern= https:\/\/(api|api-cs.*)\.intsig\.net\/purchase\/cs\/query_prop

# > Monkey
#hostname = app.monkeyuni.net
Monkey = type=http-response,pattern=^https:\/\/app\.monkeyuni\.net\/user\/api\/v\d\/account\/load-update,requires-body=1,max-size=0,script-path=https://ifade.vercel.app/scripts/Monkey.js

# > SpotifyPremium
#hostname = spclient.wg.spotify.com
Spotify-Premium = type=http-response,pattern=^https:\/\/spclient\.wg\.spotify\.com\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/zozocao/SurgeLK/main/scripts/zozocao/spotify.js,script-update-interval=0
Spotify-json-Premium = type=http-request,pattern=^https:\/\/spclient\.wg\.spotify\.com\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/,requires-body=0,script-path=https://raw.githubusercontent.com/zozocao/SurgeLK/main/scripts/zozocao/spotify-json.js

# > Camera360-Mix
#hostname = bmall.camera360.com
Camera360 = type=http-response,pattern=^https:\/\/bmall\.camera360\.com\/api\/iap\/check-receipt,requires-body=1,max-size=0,script-path=https://ifade.vercel.app/scripts/camera360.js,script-update-interval=0
Camera360-Mix = requires-body=1,script-path=https://ifade.vercel.app/scripts/verify_receipt.js,type=http-response,pattern=^https:\/\/bmall\.camera360\.com\/api\/mix\/recovery$

# > Unlock Any Buy Apple
#hostname = buy.itunes.apple.com
Buy = type=http-response,pattern=(^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt|^https:\/\/sk\.ulysses\.app\/api\/v1\/itunes_receipt_verify),requires-body=1,max-size=0,script-path=https://ifade.vercel.app/scripts/verify_receipt.js,script-update-interval=-1

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad data-type=text data="" status-code=200


[MITM]
hostname = %APPEND% sub.store, ap*.intsig.net, app.monkeyuni.net, spclient.wg.spotify.com, api.vtvgiaitri.vn, buy.itunes.apple.com, *.googlevideo.com, youtubei.googleapis.com
