#!name= Unlock iTranslate
#!desc= iTranslate

[MITM]
hostname = %APPEND% *api.itranslateapp.com
[Script]
iTranslate = type=http-response,pattern=^https:\/\/ssl-api\.itranslateapp\.com\/.*\/subscriptions\/.*\/ios$,requires-body=1,max-size=0,script-update-interval=-1,script-path=https://ifade.vercel.app/scripts/itranslate.js
