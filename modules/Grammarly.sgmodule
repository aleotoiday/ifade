#!name= Unlock Grammarly
#!desc= Grammarly

[MITM]
hostname = %APPEND% subscription.grammarly.com
[Script]
Grammarly = type=http-response,pattern=^https?:\/\/subscription\.grammarly\.com\/api\/v\d\/subscription$,requires-body=1,max-size=0,script-update-interval=-1,script-path=https://ifade.vercel.app/scripts/grammarly.js
