#!name= Unlock Camera360
#!desc= Camera360

[MITM]
hostname = %APPEND% bmall.camera360.com
[Script]
Camera360 = type=http-response,pattern=^https:\/\/bmall\.camera360\.com\/api\/iap\/check-receipt,requires-body=1,max-size=0,script-path=https://ifade.vercel.app/scripts/camera360.js,script-update-interval=0
Camera360-Mix = requires-body=1,script-path=https://ifade.vercel.app/scripts/verify_receipt.js,type=http-response,pattern=^https:\/\/bmall\.camera360\.com\/api\/mix\/recovery$
